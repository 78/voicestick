menu "Voice Stick"

    config VOICE_STICK_DEEP_SLEEP_TIMEOUT_S
        int "Idle time on battery before deep sleep (seconds)"
        range 30 86400
        default 300
        help
            Deep sleep drops the BLE connection; the talk button or USB wakes
            the device again.

    config VOICE_STICK_BLE_BATTERY_STATUS
        bool "Report battery status over BLE"
        default n

endmenu
