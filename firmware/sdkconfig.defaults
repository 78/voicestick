CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_ota.csv"
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=100
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=256
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=0
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_SIZE=320
CONFIG_FREERTOS_HZ=1000
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
# Kleines Ziffernblatt neben dem Wort "Koppeln": "07:42" ist reines ASCII,
# hier braucht es keine eigene Schrift.
#
# Die 48er ist entfallen. Das grosse Ziffernblatt setzt seit 08/2026
# `todoteck_clock_64` (ui_status/fonts) -- eine Schrift aus zwoelf Zeichen,
# die deshalb bei gleicher Kastenhoehe deutlich groessere Ziffern zeigt als
# eine vollstaendige. Die eingebaute 48er bringt dagegen den ganzen
# Latin-Satz mit, von dem hier nie mehr als zehn Ziffern und ein Doppelpunkt
# gebraucht wurden.
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Stack des main-Tasks (app_main): 6 KB statt der 3,5 KB Vorgabe. app_main
# richtet Anzeige, Board, Sensor und Bluetooth ein und ruft dabei LVGL und
# NimBLE mit ihren eigenen Puffern auf dem Stack -- 0.4.1 stuerzte auf der Uhr
# vor der OTA-Bestaetigung ab, ohne Log; ein Stack-Ueberlauf in genau dieser
# Phase ist einer der Kandidaten. Gilt fuer beide Geraete.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y

# OTA mit Rueckfall: Ein neues Abbild startet erst "auf Probe". Erreicht es
# main.c bis nach dem Bluetooth-Start, bestaetigt es sich selbst
# (esp_ota_mark_app_valid_cancel_rollback); stuerzt es vorher ab, startet der
# Bootloader beim naechsten Mal die vorige Fassung. Wirkt erst, wenn der
# Bootloader einmal per USB (merged*.bin) neu geschrieben wurde -- OTA tauscht
# nur die App, nie den Bootloader.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 0.5.1: NimBLE-Host-Task groesser (Verdacht Stack-Ueberlauf beim Verbinden in 0.5.0,
# ble_control_cb zeichnet im Host-Task, der Zeichenpfad ist mit Paket J tiefer geworden).
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=7168
